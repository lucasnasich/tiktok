{
  "name": "tiktok-studio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "predev": "node scripts/regenerate-inspiration-media.mjs && node scripts/regenerate-competitor-logos.mjs && node scripts/regenerate-competitor-documents.mjs",
    "prebuild": "node scripts/regenerate-inspiration-media.mjs && node scripts/regenerate-competitor-logos.mjs && node scripts/regenerate-competitor-documents.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "inspiration:ig": "node scripts/add-instagram-inspiration.mjs",
    "inspiration:tt": "node scripts/add-tiktok-inspiration.mjs",
    "inspiration:x": "node scripts/add-x-inspiration.mjs",
    "inspiration:cosmos": "node scripts/add-cosmos-inspiration.mjs",
    "inspiration:sync": "node scripts/regenerate-inspiration-media.mjs && node scripts/regenerate-competitor-logos.mjs && node scripts/regenerate-competitor-documents.mjs",
    "inspiration:verify-audio": "python3 scripts/verify-inspiration-audio.py",
    "competitor:pdf": "node scripts/add-competitor-pdf.mjs",
    "competitor:logo": "node scripts/add-competitor-logo.mjs",
    "competitor:logos:fetch": "node scripts/fetch-competitor-logos.mjs",
    "test:planning": "node scripts/planning-generator.test.mjs",
    "test:workflow": "node scripts/slot-workflow.test.mjs",
    "studio:reset-workflow": "node scripts/reset-studio-workflow.mjs",
    "planning:store": "node scripts/planning-store-cli.mjs",
    "planning:store:status": "node scripts/planning-store-cli.mjs status",
    "planning:store:reset": "node scripts/planning-store-cli.mjs reset",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.8.2",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "playwright": "^1.55.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
